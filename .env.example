# =========================================================
# ProfAura - Environment variables (EXAMPLE / PLACEHOLDERS)
# Copy this file to `.env.local` and fill real values.
# NEVER commit `.env.local`. NEVER put secrets in NEXT_PUBLIC_* vars.
# =========================================================

# ---- Public site ----
# Production URL (SEO, canonical, sitemap, OG). Local dev = http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (client-safe) ----
# Yeh dono browser me expose hote hain - sirf public URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY

# ---- Supabase (server-only) ----
# service_role key kabhi frontend me nahi. Sirf server actions / edge functions.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY

# ---- Brevo SMTP (server-only, Phase 2) ----
# OTP / verification email in credentials se jaata hai. Frontend ko kabhi expose nahi.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=YOUR_BREVO_LOGIN
BREVO_SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY
BREVO_FROM_EMAIL=no-reply@your-domain.example
BREVO_FROM_NAME=ProfAura

# ---- Cloudflare Turnstile (Phase 2) ----
# site key public hota hai, secret key server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# ---- Content-Security-Policy (Phase 7, server-only) ----
# CSP nonce-based hai aur DEFAULT report-only chalti hai (kuch block nahi hoti,
# sirf violations report hoti hain). Production build me verify karne ke baad,
# jab yaqeen ho jaye ke koi legit resource block nahi ho raha, isay "true" set
# kar ke enforce mode on karein. Ghalat/khali value = report-only (mehfooz default).
CSP_ENFORCE=false

# ---- Error monitoring (optional, Phase 7) ----
# SENTRY_DSN=YOUR_SENTRY_DSN
